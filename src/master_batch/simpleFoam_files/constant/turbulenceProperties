FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


simulationType      RAS;

RAS
{
    RASModel        kOmega;  // change to "realizableKE" to run with the realizable K-Epsilon framework

    turbulence      on;

    printCoeffs     on;
}
