epsilonInlet    1;   // placeholder for init/outlet/walls (must be > 0)

tLen      0.252;   // Turbulence length scale at vent: 0.07*Dh (Dh: vent width in m)
tLenCT    0.673;   // Turbulence length scale at CT exhaust

