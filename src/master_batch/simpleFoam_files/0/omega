        type            atmBoundaryLayerInletOmega;

        // Flow and vertical directions
        flowDir         (1 0 0);      // wind along +x
        zDir            (0 0 1);      // vertical is +z

        // Reference wind and ABL parameters (match 0/U & 0/k)
        Uref            0;      // m/s at reference height
        Zref            10;           // reference height [m]
        z0              uniform 0.10; // roughness length [m]
        d               uniform 0;    // displacement height [m]
        zGround         uniform 0;    // ground elevation [m]

        // Model constants (explicit for clarity)
        kappa           0.41;
        Cmu             0.09;

        // Required placeholder (not used after first update); field is set by the BC
        value           uniform $omegaInlet ;
    }


